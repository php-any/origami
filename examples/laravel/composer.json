{
    "name": "origami/laravel-example",
    "description": "Origami Laravel 风格 Web 框架示例",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Bootstrap\\Auth\\": "bootstrap/auth/",
            "Bootstrap\\Console\\": "bootstrap/console/",
            "Bootstrap\\Routing\\": "bootstrap/routing/",
            "Bootstrap\\Telescope\\": "bootstrap/telescope/",
            "Bootstrap\\View\\": "bootstrap/view/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "bootstrap/env.php",
            "bootstrap/config.php",
            "bootstrap/helpers.php"
        ]
    },
    "require": {
        "php": "^8.1",
        "carbonphp/carbon-doctrine-types": "2.1.0",
        "laravel/framework": "^10.49",
        "laravel/telescope": "^4.17"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
