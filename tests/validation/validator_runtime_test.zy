<?php

use Validation\Annotation\NotBlank;
use Validation\Annotation\Size;
use Validation\Annotation\Pattern;
use Validation\Validator;

class ValidatorRuntimeDto {
    #[NotBlank(message: "username required")]
    #[Size(min: 2, max: 32)]
    #[Pattern(regexp: "/^[a-z]+$/")]
    public string $username;
}

$dto = new ValidatorRuntimeDto();
$dto->username = "a";
$violations = Validator::validate($dto);
if (count($violations) === 0) {
    Log::fatal("expected validation violations");
}

$dto->username = "valid";
$violations = Validator::validate($dto);
if (count($violations) !== 0) {
    Log::fatal("expected no violations");
}

echo "validation runtime test ok\n";
